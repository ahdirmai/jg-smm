# Copy to .env and adjust as needed. Never commit the real .env.
# All values below are non-secret local defaults for the compose stack.

# --- Postgres ---
POSTGRES_DB=smm
POSTGRES_USER=smm
POSTGRES_PASSWORD=smm
POSTGRES_PORT=24543

# --- Redis ---
REDIS_PORT=24637

# --- MinIO ---
MINIO_ROOT_USER=smm
MINIO_ROOT_PASSWORD=smmsmmsmm
MINIO_PORT=24900
MINIO_CONSOLE_PORT=24901

# --- API ---
API_PORT=24080
LOG_LEVEL=info
# Signing key for access tokens (>= 16 bytes). Override in any non-local env.
JWT_SECRET=dev-only-secret-change-me-0123456789
JWT_ISSUER=smm-api
# AES-256 key (base64, 32 bytes) for credential encryption at rest.
# Generate: openssl rand -base64 32   |   Never reuse across environments.
CREDENTIAL_KEY=v0k2nMVGJAq5Ta69vg36gcxNB4wiClCeOFMC6WBemH8=
# Cookies must be Secure in production (HTTPS). Keep false for local http.
SECURE_COOKIES=false
# Bootstrap owner created by `make seed`.
SEED_ADMIN_EMAIL=owner@smm.local
SEED_ADMIN_PASSWORD=changeme-changeme
# static = no Kubernetes, no container spawned (bookkeeping only)
# docker = local workstation: the API itself launches worker containers through
#          the mounted docker socket (default; the dashboard's Create works)
# k8s   = production provisioner
PROVISIONER_MODE=docker
# The reconciler ticks the desired-state loop that actually provisions a
# dashboard-created row. 0 disables it (production sets its own value).
RECONCILE_INTERVAL_SECONDS=5
# The docker driver's socket, network, image and published-port range.
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_NETWORK=smm_default
DOCKER_PUBLIC_HOST=localhost
WORKER_IMAGE=smm-worker
NOVNC_PORT_MIN=24100
NOVNC_PORT_MAX=24299
# Allow auto-create of a worker container when adding an account finds no free slot
PROVISION_AUTO_CREATE=true
# Workers acting in parallel per batch (local max 2 on a 16 GB machine)
ACTION_BATCH_PARALLELISM=2

# --- Worker ---
# When true, the worker stops before committing an action (like/comment/report)
ACTION_DRY_RUN=true
WORKER_PLATFORMS=instagram,threads
# P4-08 live view. A docker-provisioned container receives its own NOVNC_URL at
# create time (the API allocates a port from the range above), so these are
# only for `make up-fleet` replicas, whose 6080 is published to a random host
# port the container cannot discover on its own.
WORKER_NOVNC_URL=
WORKER_NOVNC_BASE_URL=
WORKER_NOVNC_PORT=6080

# --- Web ---
WEB_PORT=24081
NEXT_PUBLIC_API_URL=http://localhost:24080
NEXT_PUBLIC_SSE_URL=http://localhost:24080/api/stream

# --- Mail (P4-06 weekly report digest) ---
# All off by default. To try the digest locally:
#   COMPOSE_PROFILES=mail make up   (brings up mailpit)
#   REPORT_EMAIL_INTERVAL_SECONDS=604800  (weekly; use 60 to see it tick)
#   REPORT_EMAIL_TO=team@example.com
MAILPIT_SMTP_PORT=24025
MAILPIT_UI_PORT=24026
# With the mail profile running, point the API at the in-network mailpit:
#   SMTP_ADDR=mailpit:1025
SMTP_ADDR=
SMTP_HOST=
SMTP_FROM=reports@smm.local
REPORT_EMAIL_INTERVAL_SECONDS=0
REPORT_EMAIL_TO=
REPORT_EMAIL_WINDOW_DAYS=7
