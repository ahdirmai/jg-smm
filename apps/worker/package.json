{
  "name": "@smm/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@smm/shared": "workspace:*"
  },
  "devDependencies": {
    "@smm/tsconfig": "workspace:*",
    "@types/node": "22.9.0",
    "typescript": "5.6.3"
  }
}
