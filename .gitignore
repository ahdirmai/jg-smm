# accidental archives
docs.zip
*.zip
cc.txt
apps/web/test-results/
apps/web/playwright-report/
# e2e/playwright.config.ts sets outputFolder to 'report', resolved beside the config.
apps/web/e2e/report/
apps/web/e2e/test-results/
infra/backup/sessions/
# Backup output (both `make backup` and manual pre-reset dumps). Not just large:
# a logical dump carries COPY blocks for app_user (password hashes), auth_session
# (live session tokens) and account (platform credentials), and the bundles carry
# the worker sessions volume as a tar. Committing either publishes those secrets
# into git history, where deleting them later needs a rewrite. The scripts stay
# tracked; only their output is ignored.
infra/backup/backups/
infra/backup/*.sql
infra/backup/*.dump
# Timestamped backup DIRECTORIES (pre-reset, pre-deploy): `pre-*/smm-db.sql` and
# `pre-*/sessions/*.tgz` sit one level below the patterns above, so they escaped
# them — and a pre-deploy bundle is the same secret material (DB COPY blocks for
# app_user/auth_session/account, plus the worker session tars). Ignore the whole
# directory shape, not just the top-level files.
infra/backup/*/

# local dev harness deps
docs/local-worker/node_modules/
# Harness session copies (live storageState — real credentials, never commit)
docs/local-worker/*-session.json
/*-session.json
._*
